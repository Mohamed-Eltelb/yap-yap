{
  "name": "yap-yap",
  "version": "1.1.0",
  "description": "Yap Yap — Multi-provider BYOK voice dictation, translation, and AI assistant desktop app.",
  "main": "dist-electron/main.js",
  "author": "Mohamed Eltelb",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:keyhook": "cmd /c native\\windows\\build.cmd"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "koffi": "^3.3.8",
    "loudness": "^0.4.2",
    "lucide-react": "^1.72.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.8"
    },
    "@electron/universal": {
      "minimatch": "^11.0.8"
    }
  },
  "build": {
    "appId": "com.yapyap.desktop",
    "productName": "Yap Yap",
    "icon": "public/icons/app.png",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/loudness/impl/windows/*.exe",
      "node_modules/koffi/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "native/windows/build/yapyap-keys.dll",
          "to": "yapyap-keys.dll"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Yap Yap records your voice while you dictate.",
        "NSAppleEventsUsageDescription": "Yap Yap pastes your dictation and reads the current website in your browser, so it can match how you write there. It never reads the page's content."
      }
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
